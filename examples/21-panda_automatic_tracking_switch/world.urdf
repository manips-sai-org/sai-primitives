<?xml version="1.0" ?>

<world name="demo_world" gravity="0.0 0.0 0.0">

	<robot name="PANDA">
		<model dir="${SAI_MODEL_URDF_FOLDER}/panda" path="panda_arm_sphere.urdf" name="panda" />
	</robot>

	<static_object name="Floor">
		<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="3.0 3.0 0.1" />
			</geometry>
			<material name="material_gray">
				<color rgba="0.1 0.1 0.1 1.0" />
			</material>
		</visual>
	</static_object>

	<dynamic_object name="DiscreteGoalA">
		<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
		<inertial>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<mass value="0.01" />
			<inertia ixx="0.00001" iyy="0.00001" izz="0.00001" ixy="0" ixz="0" iyz="0" />
		</inertial>
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<sphere radius="0.018" />
			</geometry>
			<material name="material_goal_a">
				<color rgba="0.0 0.45 1.0 1.0" />
			</material>
		</visual>
	</dynamic_object>

	<dynamic_object name="DiscreteGoalB">
		<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
		<inertial>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<mass value="0.01" />
			<inertia ixx="0.00001" iyy="0.00001" izz="0.00001" ixy="0" ixz="0" iyz="0" />
		</inertial>
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<sphere radius="0.018" />
			</geometry>
			<material name="material_goal_b">
				<color rgba="0.0 0.8 0.35 1.0" />
			</material>
		</visual>
	</dynamic_object>

	<dynamic_object name="ActiveGoal">
		<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
		<inertial>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<mass value="0.01" />
			<inertia ixx="0.00001" iyy="0.00001" izz="0.00001" ixy="0" ixz="0" iyz="0" />
		</inertial>
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<sphere radius="0.026" />
			</geometry>
			<material name="material_active_goal">
				<color rgba="1.0 0.55 0.0 1.0" />
			</material>
		</visual>
	</dynamic_object>

	<light name="light1" type="directional">
		<position xyz="2.0 -2.0 2.0" />
		<lookat xyz="0.0 0.0 0.0" />
	</light>

	<light name="light2" type="directional">
		<position xyz="2.0 2.0 2.0" />
		<lookat xyz="0.0 0.0 0.0" />
	</light>

	<camera name="camera">
		<position xyz="1.5 0.4 1.0" />
		<vertical xyz="0.0 0.0 1.0" />
		<lookat xyz="0.0 0.0 0.5" />
	</camera>

</world>
