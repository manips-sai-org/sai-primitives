<?xml version="1.0" ?>

<world name="demo_world" gravity="0.0 0.0 0.0">

	<robot name="PANDA_AOB">
		<model dir="${SAI_MODEL_URDF_FOLDER}/panda" path="panda_arm_sphere.urdf" name="panda" />
		<origin xyz="0.0 0.35 0.0" rpy="0 0 0" />
	</robot>

	<robot name="PANDA_FIXED">
		<model dir="${SAI_MODEL_URDF_FOLDER}/panda" path="panda_arm_sphere.urdf" name="panda" />
		<origin xyz="0.0 -0.35 0.0" rpy="0 0 0" />
	</robot>

	<static_object name="Floor">
		<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="3.0 3.0 0.1" />
			</geometry>
			<material name="material_red">
				<color rgba="0.1 0.1 0.1 1.0" />
			</material>
		</visual>
	</static_object>

	<static_object name="TableAOB">
		<origin xyz="0.45 0.40 0.3" rpy="0 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="0.3 0.3 0.03" />
			</geometry>
			<material name="material_aob_table">
				<color rgba="0.08 0.23 0.62 1.0" />
			</material>
		</visual>
	</static_object>

	<static_object name="TableFixed">
		<origin xyz="0.45 -0.30 0.3" rpy="0 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="0.3 0.3 0.03" />
			</geometry>
			<material name="material_fixed_table">
				<color rgba="0.36 0.38 0.42 1.0" />
			</material>
		</visual>
	</static_object>

	<dynamic_object name="StiffnessMarkerAOB">
		<origin xyz="0.45 0.40 0.34" rpy="0 0 0" />
		<inertial>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<mass value="0.01" />
			<inertia ixx="0.00001" iyy="0.00001" izz="0.00001" ixy="0" ixz="0" iyz="0" />
		</inertial>
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="0.22 0.05 0.024" />
			</geometry>
			<material name="material_stiffness_marker_aob">
				<color rgba="1.0 0.50 0.10 1.0" />
			</material>
		</visual>
	</dynamic_object>

	<dynamic_object name="StiffnessMarkerFixed">
		<origin xyz="0.45 -0.30 0.34" rpy="0 0 0" />
		<inertial>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<mass value="0.01" />
			<inertia ixx="0.00001" iyy="0.00001" izz="0.00001" ixy="0" ixz="0" iyz="0" />
		</inertial>
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="0.22 0.05 0.024" />
			</geometry>
			<material name="material_stiffness_marker_fixed">
				<color rgba="1.0 0.50 0.10 1.0" />
			</material>
		</visual>
	</dynamic_object>

	<light name="light1" type="directional">
		<position xyz="2.0 -2.0 2.0" />
		<lookat xyz="0.0 0.0 0.0" />
	</light>

	<light name="light2" type="directional">
		<position xyz="2.0 2.0 2.0" />
		<lookat xyz="0.0 0.0 0.0" />
	</light>

	<camera name="camera">
		<position xyz="2.2 0.0 1.1" />
		<vertical xyz="0.0 0.0 1.0" />
		<lookat xyz="0.30 0.0 0.45" />
	</camera>

</world>
