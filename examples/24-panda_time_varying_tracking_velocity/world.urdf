<?xml version="1.0" ?>

<world name="demo_world" gravity="0.0 0.0 0.0">

	<robot name="PANDA">
		<model dir="${SAI_MODEL_URDF_FOLDER}/panda" path="panda_arm_sphere.urdf" name="panda" />
	</robot>

	<static_object name="Floor">
		<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<box size="3.0 3.0 0.1" />
			</geometry>
			<material name="material_gray">
				<color rgba="0.1 0.1 0.1 1.0" />
			</material>
		</visual>
	</static_object>

	<dynamic_object name="GoalCenter">
		<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
		<inertial>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<mass value="0.01" />
			<inertia ixx="0.00001" iyy="0.00001" izz="0.00001" ixy="0" ixz="0" iyz="0" />
		</inertial>
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<sphere radius="0.012" />
			</geometry>
			<material name="material_goal_center">
				<color rgba="0.0 0.45 1.0 1.0" />
			</material>
		</visual>
	</dynamic_object>

	<dynamic_object name="DesiredPoint">
		<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
		<inertial>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<mass value="0.01" />
			<inertia ixx="0.00001" iyy="0.00001" izz="0.00001" ixy="0" ixz="0" iyz="0" />
		</inertial>
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<sphere radius="0.018" />
			</geometry>
			<material name="material_desired_point">
				<color rgba="0.0 0.85 0.95 1.0" />
			</material>
		</visual>
	</dynamic_object>

	<dynamic_object name="ActiveGoal">
		<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
		<inertial>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<mass value="0.01" />
			<inertia ixx="0.00001" iyy="0.00001" izz="0.00001" ixy="0" ixz="0" iyz="0" />
		</inertial>
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
			<geometry>
				<sphere radius="0.026" />
			</geometry>
			<material name="material_active_goal">
				<color rgba="1.0 0.55 0.0 1.0" />
			</material>
		</visual>
	</dynamic_object>

	<static_object name="VelocityPlotTimeAxis">
		<origin xyz="-0.55 0.0 0.32" rpy="0 0 0" />
		<visual><origin xyz="0 0 0" rpy="0 0 0" /><geometry><box size="0.012 0.90 0.012" /></geometry><material name="material_plot_axis"><color rgba="0.75 0.75 0.75 1.0" /></material></visual>
	</static_object>

	<static_object name="VelocityPlotValueAxis">
		<origin xyz="-0.55 -0.45 0.545" rpy="0 0 0" />
		<visual><origin xyz="0 0 0" rpy="0 0 0" /><geometry><box size="0.012 0.012 0.45" /></geometry><material name="material_plot_axis"><color rgba="0.75 0.75 0.75 1.0" /></material></visual>
	</static_object>

	<static_object name="VelocityPlotTopAxis">
		<origin xyz="-0.55 0.0 0.77" rpy="0 0 0" />
		<visual><origin xyz="0 0 0" rpy="0 0 0" /><geometry><box size="0.012 0.90 0.008" /></geometry><material name="material_plot_axis"><color rgba="0.35 0.35 0.35 1.0" /></material></visual>
	</static_object>

