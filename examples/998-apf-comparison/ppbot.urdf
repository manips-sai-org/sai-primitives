<?xml version="1.0" ?>
<!--simple pp branching robot-->

<robot name="ppbot">
    <link name="base_link">
    </link>

    <link name="link0">
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
            <mass value="0.0000000000001" />
            <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0" />
        </inertial>
    </link>

    <link name="link1">
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
            <!-- <mass value="0.000001" /> -->
            <mass value="1" />
            <inertia ixx="0.000001" iyy="0.000001" izz="0.000001" ixy="0" ixz="0" iyz="0" />
        </inertial>
        <visual>
            <origin xyz="0.0 0.0 0.000001" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="0.035" length="0.04"/>
            </geometry>
            <material name="red">
                <!-- <color rgba="0.5294, 0.8078, 0.9216 1.0"/> -->
                <color rgba="0.2706, 0.4353, 0.6784 1.0"/>
            </material>
        </visual>
    </link>

    <joint name="j0" type="prismatic">
        <parent link="base_link" />
        <child link="link0" />
        <origin xyz="0.000000 0.000000 0.000000" rpy="-0.000000 0.000000 -0.000000" />
        <axis xyz="1 0 0" />
        <limit lower="-2.967" upper="2.967" effort="176" velocity="1.7104" />
    </joint>

    <joint name="j1" type="prismatic">
        <parent link="link0" />
        <child link="link1" />
        <origin xyz="0.000000 0.000000 0.000000" rpy="-0.000000 0.000000 -0.000000" />
        <axis xyz="0 1 0" />
        <limit lower="-2.967" upper="2.967" effort="176" velocity="1.7104" />
    </joint>


</robot>



